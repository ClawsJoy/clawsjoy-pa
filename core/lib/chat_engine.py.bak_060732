#!/usr/bin/env python3
"""统一对话引擎 - 完整版"""

import requests
import logging
import re
from typing import Dict, List
from datetime import datetime
from collections import defaultdict

logger = logging.getLogger(__name__)


class UnifiedChatEngine:
    def __init__(self):
        self.enabled = True
        self.llm_url = "http://localhost:5012/chat"
        self.timeout = 120
        self.max_retries = 3
        self.conversations: Dict[str, List[Dict]] = defaultdict(list)
        self.user_profiles: Dict[str, Dict] = defaultdict(dict)
        self.max_history = 10
        logger.info("✅ ChatEngine 初始化完成")

    def _build_context_prompt(self, user_id: str, current_message: str) -> str:
        """构建带上下文的提示词"""
        history = self.conversations.get(user_id, [])
        profile = self.user_profiles.get(user_id, {})
        
        context_parts = []
        
        if profile.get('name'):
            context_parts.append(f"用户姓名: {profile['name']}")
        if profile.get('preferences'):
            context_parts.append(f"用户偏好: {', '.join(profile['preferences'])}")
        
        if history:
            context_parts.append("\n对话历史:")
            for msg in history[-6:]:  # 最近6条消息
                role = "用户" if msg["role"] == "user" else "助手"
                context_parts.append(f"{role}: {msg['content']}")
        
        context_parts.append(f"\n当前问题: {current_message}")
        context_parts.append("请基于以上对话历史回答。如果用户问及之前的信息，请从历史中回忆。")
        
        return "\n".join(context_parts)

    def _extract_user_info(self, user_id: str, message: str):
        """提取用户信息"""
        profile = self.user_profiles.get(user_id, {})
        
        # 提取名字
        patterns = [r'我叫([^，,。]+)', r'我是([^，,。]+)', r'name is (\w+)']
        for pattern in patterns:
            match = re.search(pattern, message, re.IGNORECASE)
            if match:
                profile['name'] = match.group(1).strip()
                logger.info(f"提取到名字: {profile['name']}")
                break
        
        # 提取偏好
        pref_patterns = [r'我喜欢([^，,。]+)', r'like (\w+)']
        for pattern in pref_patterns:
            match = re.search(pattern, message, re.IGNORECASE)
            if match:
                pref = match.group(1).strip()
                if 'preferences' not in profile:
                    profile['preferences'] = []
                if pref not in profile['preferences']:
                    profile['preferences'].append(pref)
                logger.info(f"提取到偏好: {pref}")
                break
        
        self.user_profiles[user_id] = profile

    def execute(self, message: str, user_id: str = "guest") -> Dict:
        """执行对话，带记忆功能"""
        logger.info(f"处理用户 {user_id}: {message[:50]}...")

        # 提取用户信息
        self._extract_user_info(user_id, message)

        # 构建带上下文的提示词
        context_message = self._build_context_prompt(user_id, message)

        # 调用 LLM
        for attempt in range(self.max_retries):
            try:
                resp = requests.post(
                    self.llm_url,
                    json={"message": context_message},
                    timeout=self.timeout,
                    headers={"Content-Type": "application/json"}
                )

                if resp.status_code == 200:
                    result = resp.json()
                    response = result.get("response", "")

                    if response:
                        # 保存对话历史
                        self.conversations[user_id].append({
                            "role": "user",
                            "content": message,
                            "timestamp": datetime.now().isoformat()
                        })

                        self.conversations[user_id].append({
                            "role": "assistant",
                            "content": response,
                            "timestamp": datetime.now().isoformat()
                        })

                        # 限制历史长度
                        if len(self.conversations[user_id]) > self.max_history * 2:
                            self.conversations[user_id] = self.conversations[user_id][-self.max_history * 2:]

                        logger.info(f"✅ 响应成功，历史长度: {len(self.conversations[user_id])}")

                        return {
                            "success": True,
                            "response": response,
                            "agent": "chat_engine_with_memory",
                            "user_id": user_id
                        }
                    else:
                        if attempt < self.max_retries - 1:
                            logger.warning(f"空响应，重试 {attempt+1}/{self.max_retries}")
                            continue
                        return {
                            "success": False,
                            "response": "LLM 返回空响应",
                            "agent": "error",
                            "user_id": user_id
                        }
                else:
                    logger.error(f"HTTP {resp.status_code}")
                    if attempt < self.max_retries - 1:
                        continue
                    return {
                        "success": False,
                        "response": f"LLM 服务错误: {resp.status_code}",
                        "agent": "error",
                        "user_id": user_id
                    }

            except requests.Timeout:
                logger.error(f"超时 (尝试 {attempt+1}/{self.max_retries})")
                if attempt < self.max_retries - 1:
                    continue
                return {
                    "success": False,
                    "response": "LLM 服务响应超时",
                    "agent": "error",
                    "user_id": user_id
                }
            except Exception as e:
                logger.error(f"异常: {e}")
                if attempt < self.max_retries - 1:
                    continue
                return {
                    "success": False,
                    "response": f"服务异常: {str(e)}",
                    "agent": "error",
                    "user_id": user_id
                }

        return {
            "success": False,
            "response": "服务暂时不可用",
            "agent": "error",
            "user_id": user_id
        }

    def clear_history(self, user_id: str = None):
        """清除对话历史"""
        if user_id:
            self.conversations[user_id] = []
            self.user_profiles[user_id] = {}
            logger.info(f"已清除用户 {user_id} 的历史")
        else:
            self.conversations.clear()
            self.user_profiles.clear()
            logger.info("已清除所有历史")


chat_engine = UnifiedChatEngine()
