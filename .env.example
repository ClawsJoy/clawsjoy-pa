# ClawsJoy 环境配置模板
# 复制为 .env 并填入你自己的密钥：
#   cp .env.example .env
# 请勿将真实 .env 提交到 Git（已在 .gitignore 中排除）。

# JWT 认证密钥（务必更换为随机值，至少 32 字节）
JWT_SECRET=your_fixed_32_byte_secret_key_here_change_it

# 项目根目录
PROJECT_ROOT=/path/to/clawsjoy

# JWT 过期时间（小时）
JWT_EXPIRE_HOURS=24

# 日志级别
LOG_LEVEL=INFO

# 服务端口配置
GATEWAY_PORT=5002
MOBILE_PORT=5003
LLM_PORT=5012

# Google OAuth（如需使用 YouTube 等功能，取消注释并填入）
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# LLM 配置（本地 Ollama 默认）
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama

# ========== 互联网资讯 API 配置 ==========
# 网易资讯（取消注释启用）
NEWS_API_ENABLED=true
NEWS_API_BASE_URL=https://api.163.com
NEWS_API_KEY=your_news_api_key

# 热搜榜 API
HOTSEARCH_API_URL=https://api.hotsearch.com
TRENDING_API_URL=https://api.trending.com

# 科学探索 API（IT之家）
SCIENCE_API_URL=https://api.ithome.com

# 科技资讯 API
TECH_API_URL=https://api.tech.com

# 体育资讯 API
SPORTS_API_URL=https://api.sports.com

# ========== 第三方 API 完整配置 ==========
# 网易互联网/科技
NETEASE_API_URL=https://api.163.com
NETEASE_API_KEY=your_netease_api_key

# IT之家（科技/科学/AI）
ITHOME_API_URL=https://api.ithome.com
ITHOME_API_KEY=your_ithome_api_key

# 热搜榜
HOTSEARCH_API_URL=https://api.hotsearch.com
TRENDING_API_URL=https://api.trending.com

# 体育资讯
SPORTS_API_URL=https://api.sports.com

# 人工智能资讯
AI_API_URL=https://api.ai.com

# 互联网资讯
INTERNET_API_URL=https://api.internet.com
TIAN_API_KEY=your_tian_api_key

# ========== AI 模型配置 ==========
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_ENDPOINT=https://api.deepseek.com
