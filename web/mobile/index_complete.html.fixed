<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>ClawsJoy - 智能语音助手</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 16px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 24px 20px;
            text-align: center;
        }
        .header h1 { font-size: 28px; margin-bottom: 4px; }
        .status-card {
            background: #f8f9fa;
            margin: 16px;
            padding: 16px;
            border-radius: 20px;
            text-align: center;
        }
        .status-icon { font-size: 48px; margin-bottom: 8px; }
        .status-text { font-size: 16px; font-weight: 600; }
        .status-detail { font-size: 11px; color: #666; margin-top: 4px; }
        .messages {
            height: 350px;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #fafafa;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
        }
        .message {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.4;
        }
        .message.user {
            background: #667eea;
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }
        .message.assistant {
            background: #e9ecef;
            color: #333;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        .message.system {
            background: #fff3cd;
            color: #856404;
            align-self: center;
            font-size: 12px;
            max-width: 90%;
        }
        .input-area {
            padding: 16px;
            display: flex;
            gap: 10px;
            background: white;
        }
        .input-area input {
            flex: 1;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 30px;
            font-size: 16px;
        }
        .voice-btn {
            background: #f0f0f0;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            font-size: 24px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .voice-btn.recording {
            background: #ff4444;
            color: white;
            animation: pulse 1s infinite;
        }
        .send-btn {
            background: #667eea;
            border: none;
            padding: 0 24px;
            border-radius: 30px;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }
        .quick-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 12px 16px;
            background: #f8f9fa;
            border-top: 1px solid #eee;
        }
        .quick-btn {
            background: white;
            border: 1px solid #ddd;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
        }
        .footer { text-align: center; padding: 16px; color: #999; font-size: 11px; }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .recording-tip {
            font-size: 12px;
            color: #ff4444;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🤖 ClawsJoy</h1>
            <p>智能语音助手 · 离线识别</p>
        </div>

        <div class="status-card">
            <div class="status-icon" id="statusIcon">🎤</div>
            <div class="status-text" id="statusText">点击麦克风说话</div>
            <div class="status-detail" id="statusDetail">VOSK 离线识别 · 隐私安全</div>
        </div>

        <div class="messages" id="messages">
            <div class="message assistant">👋 你好！我是 ClawsJoy 助手。<br><br>
            💡 点击🎤说话，我说什么都能识别<br>
            📖 问问题：「台州有什么好玩的」<br>
            🔧 教我：「记住 问题 → 答案」<br>
            🔊 我会用语音回答你</div>
        </div>

        <div class="quick-buttons">
            <button class="quick-btn" onclick="sendQuick('北京天气')">🌤️ 天气</button>
            <button class="quick-btn" onclick="sendQuick('用粤语说你好')">🗣️ 方言</button>
            <button class="quick-btn" onclick="sendQuick('1+2+3')">🧮 计算</button>
            <button class="quick-btn" onclick="sendQuick('现在几点')">⏰ 时间</button>
            <button class="quick-btn" onclick="openTeach()">📖 教我</button>
            <button class="quick-btn" onclick="location.href='train_wakeword.html'">🎓 训练唤醒词</button>
        </div>

        <div class="input-area">
            <button class="voice-btn" id="voiceBtn">🎤</button>
            <input type="text" id="userInput" placeholder="输入消息..." autocomplete="off">
            <button class="send-btn" id="sendBtn">发送</button>
        </div>

        <div class="footer">
            🔒 离线识别 · 隐私安全 · 语音自动回复
        </div>
    </div>

    <script>
        let mediaRecorder = null;
        let audioChunks = [];
        let isRecording = false;
        let isProcessing = false;

        const messagesDiv = document.getElementById('messages');
        const userInput = document.getElementById('userInput');
        const statusIcon = document.getElementById('statusIcon');
        const statusText = document.getElementById('statusText');
        const statusDetail = document.getElementById('statusDetail');
        const voiceBtn = document.getElementById('voiceBtn');

        // 添加消息
        function addMessage(role, text) {
            const div = document.createElement('div');
            div.className = `message ${role}`;
            div.textContent = text;
            messagesDiv.appendChild(div);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
            return div;
        }

        function addSystemMessage(text) {
            const div = document.createElement('div');
            div.className = 'message system';
            div.textContent = text;
            messagesDiv.appendChild(div);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
            setTimeout(() => div.remove(), 2000);
        }

        // TTS语音播报
        async function speakText(text) {
        return; // 禁用前端TTS
            if (!text || text.length === 0) return;
            
            try {
                const response = await fetch('/api/tts/speak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: text.substring(0, 200) })
                });
                const data = await response.json();
                if (data.status === 'success') {
                    console.log('TTS: 正在播报');
                }
            } catch (e) {
                console.error('TTS error:', e);
            }
        }

        // 发送消息到智能Agent
        async function sendMessage(text) {
            if (!text || !text.trim() || isProcessing) return;

            isProcessing = true;
            addMessage('user', text);
            userInput.value = '';

            try {
                const response = await fetch('/api/agent/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        message: text, 
                        user_id: 'mobile_' + Date.now() 
                    })
                });
                const data = await response.json();
                const reply = data.response || '处理完成';
                addMessage('assistant', reply);
                
                // 自动语音播报回复
                await speakText(reply);
                
            } catch (e) {
                console.error('API error:', e);
                addMessage('assistant', '网络错误，请检查服务是否启动');
            } finally {
                isProcessing = false;
            }
        }

        function sendQuick(text) {
            sendMessage(text);
        }

        function openTeach() {
            const question = prompt('📖 教我新知识\n\n问题：', '');
            if (question && question.trim()) {
                const answer = prompt(`「${question}」的答案是：`, '');
                if (answer && answer.trim()) {
                    sendMessage(`记住「${question}」→「${answer}」`);
                }
            }
        }

        // 语音识别 - 录制并发送到后端
        async function startRecording() {
            if (isProcessing) {
                addSystemMessage('请等待上一条消息处理完成');
                return;
            }

            audioChunks = [];
            
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                
                // 使用 MediaRecorder 录制
                mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
                
                mediaRecorder.ondataavailable = (event) => {
                    if (event.data.size > 0) {
                        audioChunks.push(event.data);
                    }
                };

                mediaRecorder.onstop = async () => {
                    statusText.textContent = '识别中...';
                    statusIcon.textContent = '🤔';
                    statusDetail.textContent = '正在识别语音';

                    try {
                        // 将录音转换为 WAV 格式
                        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        
                        // 转换为 WAV（使用 AudioContext）
                        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                        const arrayBuffer = await audioBlob.arrayBuffer();
                        const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);
                        
                        // 转换为 WAV
                        const wavBlob = audioBufferToWav(audioBuffer);
                        
                        const formData = new FormData();
                        formData.append('audio', wavBlob, 'recording.wav');
                        
                        const response = await fetch('/api/voice/recognize', {
                            method: 'POST',
                            body: formData
                        });
                        
                        const data = await response.json();
                        
                        if (data.status === 'success' && data.text && data.text.trim()) {
                            const recognizedText = data.text;
                            addSystemMessage(`🎤 识别: "${recognizedText}"`);
                            // 发送识别结果到对话
                            await sendMessage(recognizedText);
                            statusDetail.textContent = '✅ 识别成功';
                        } else {
                            addSystemMessage('⚠️ 未识别到语音，请重试');
                            statusDetail.textContent = '未识别到语音';
                            statusIcon.textContent = '🎤';
                        }
                    } catch (e) {
                        console.error('Recognition error:', e);
                        addSystemMessage('❌ 识别失败: ' + e.message);
                        statusDetail.textContent = '识别失败';
                        statusIcon.textContent = '🎤';
                    } finally {
                        isRecording = false;
                        voiceBtn.classList.remove('recording');
                        statusText.textContent = '点击麦克风说话';
                        if (statusDetail.textContent !== '识别失败') {
                            statusIcon.textContent = '🎤';
                        }
                        // 释放麦克风
                        stream.getTracks().forEach(track => track.stop());
                    }
                };

                // 开始录制
                mediaRecorder.start();
                isRecording = true;
                voiceBtn.classList.add('recording');
                statusIcon.textContent = '🎙️';
                statusText.textContent = '录音中...';
                statusDetail.textContent = '请说话，3秒后自动停止';

                // 3秒后自动停止
                setTimeout(() => {
                    if (mediaRecorder && mediaRecorder.state === 'recording') {
                        mediaRecorder.stop();
                    }
                }, 3000);

            } catch (err) {
                console.error('Microphone error:', err);
                addSystemMessage('❌ 无法获取麦克风权限，请检查设置');
                statusDetail.textContent = '麦克风权限被拒绝';
            }
        }

        // 将 AudioBuffer 转换为 WAV Blob
        function audioBufferToWav(buffer) {
            const numChannels = buffer.numberOfChannels;
            const sampleRate = buffer.sampleRate;
            const format = 1; // PCM
            const bitDepth = 16;
            
            let samples = buffer.getChannelData(0);
            let wavBuffer = new ArrayBuffer(44 + samples.length * 2);
            let view = new DataView(wavBuffer);
            
            // 写入 WAV 头
            writeString(view, 0, 'RIFF');
            view.setUint32(4, 36 + samples.length * 2, true);
            writeString(view, 8, 'WAVE');
            writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, format, true);
            view.setUint16(22, numChannels, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, sampleRate * numChannels * 2, true);
            view.setUint16(32, numChannels * 2, true);
            view.setUint16(34, bitDepth, true);
            writeString(view, 36, 'data');
            view.setUint32(40, samples.length * 2, true);
            
            // 写入音频数据
            let offset = 44;
            for (let i = 0; i < samples.length; i++) {
                let sample = Math.max(-1, Math.min(1, samples[i]));
                view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);
                offset += 2;
            }
            
            return new Blob([view], { type: 'audio/wav' });
        }
        
        function writeString(view, offset, str) {
            for (let i = 0; i < str.length; i++) {
                view.setUint8(offset + i, str.charCodeAt(i));
            }
        }

        // 事件绑定
        voiceBtn.addEventListener('click', () => {
            if (isRecording) {
                if (mediaRecorder && mediaRecorder.state === 'recording') {
                    mediaRecorder.stop();
                }
            } else {
                startRecording();
            }
        });

        document.getElementById('sendBtn').addEventListener('click', () => {
            const text = userInput.value.trim();
            if (text) sendMessage(text);
        });

        userInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const text = userInput.value.trim();
                if (text) sendMessage(text);
            }
        });

        // 检查服务状态
        async function checkService() {
            try {
                const response = await fetch('/api/voice/status');
                const data = await response.json();
                if (data.vosk_available) {
                    console.log('✅ 语音服务正常');
                }
            } catch (e) {
                console.error('服务连接失败');
            }
        }
        checkService();
        
        console.log('ClawsJoy 已启动');
    </script>
</body>
</html>
<script>
// ========== 唤醒词检测（使用训练好的模型）==========
let wakeWordDetection = null;
let trainedWakeWord = null;

function loadTrainedWakeWord() {
    const savedModel = localStorage.getItem('clawsjoy_wakeword_model');
    if (savedModel) {
        try {
            const model = JSON.parse(savedModel);
            trainedWakeWord = model.wakeWord;
            addSystemMessage(`🎤 已加载唤醒词: "${trainedWakeWord}"`);
            startWakeWordListener();
            return true;
        } catch(e) {
            console.error('解析唤醒词模型失败', e);
        }
    }
    addSystemMessage('⚠️ 未找到唤醒词模型，请先到"训练唤醒词"页面训练');
    return false;
}

function startWakeWordListener() {
    if (!trainedWakeWord) return;
    
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        addSystemMessage('浏览器不支持语音唤醒');
        return;
    }
    
    if (wakeWordDetection) {
        wakeWordDetection.stop();
    }
    
    wakeWordDetection = new SpeechRecognition();
    wakeWordDetection.continuous = true;
    wakeWordDetection.interimResults = true;
    wakeWordDetection.lang = 'zh-CN';
    
    wakeWordDetection.onresult = (event) => {
        let transcript = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
            transcript += event.results[i][0].transcript;
        }
        if (transcript.toLowerCase().includes(trainedWakeWord.toLowerCase())) {
            addSystemMessage(`🎯 检测到唤醒词 "${trainedWakeWord}"，正在聆听...`);
            if (!isRecording) {
                startRecording();
            }
        }
    };
    
    wakeWordDetection.onerror = (event) => {
        console.error('唤醒词监听错误:', event.error);
        if (event.error === 'not-allowed') {
            addSystemMessage('请允许麦克风权限以使用语音唤醒');
        }
    };
    
    wakeWordDetection.start();
    addSystemMessage(`🔊 唤醒词监听已启动，说 "${trainedWakeWord}" 唤醒`);
}

function stopWakeWordListener() {
    if (wakeWordDetection) {
        wakeWordDetection.stop();
        wakeWordDetection = null;
        addSystemMessage('⏹️ 唤醒词监听已停止');
    }
}

// 页面加载时启动唤醒监听
setTimeout(() => {
    loadTrainedWakeWord();
}, 1000);
</script>
<script>
// 修改唤醒检测，同时通知后端
// 找到 wakeWordDetection.onresult 部分，添加后端通知
</script>
