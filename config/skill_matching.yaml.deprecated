    - example_skill
    - feeding
    - story
    - drawing
    - backup
    - light
    - temperature
    - Model_Enable_Intel_XPU
    - my_calc
    - do_anything

  params:
    default_n: 3
    min_similarity: 0.4
    fallback_to_vector: false
    hybrid_search: true

    # 分析相关
    分析:
      - requirement_analyzer
      - intent_parser
    需求:
      - requirement_analyzer
    业务:
      - requirement_analyzer
    销售:
