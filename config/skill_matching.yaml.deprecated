    # 协作相关
    协作:
      - collaboration
    合作:
      - collaboration
    团队:
      - collaboration
    协同:
      - collaboration

    # 决策相关
    决策:
      - decision_maker
    决定:
      - decision_maker
    选择:
      - decision_maker
    判断:
      - decision_maker

    # 开发相关
    开发:
      - development
      - smart_execute
    编码:
      - development
    调试:
      - development

    # 测试相关
    测试:
      - test_skill
    验证:
      - test_skill

    # 文件操作
    文件:
      - file_processor
      - read_file
    读取:
      - read_file
    写入:
      - write_file

    # 网络请求
    请求:
